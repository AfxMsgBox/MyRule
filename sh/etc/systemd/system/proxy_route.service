[Unit]
Description=MyProxy fake-IP route monitor
Documentation=https://github.com/AfxMsgBox/MyRule
PartOf=proxy_core.service
Before=proxy_core.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/sh -c 'MP_INST_DIR=/etc/proxy; export MP_INST_DIR; exec /bin/sh "$MP_INST_DIR/sh/setup-fake-ip-route.sh" --watch'
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/proxy/core
StandardOutput=journal
StandardError=journal
SyslogIdentifier=MyProxy
